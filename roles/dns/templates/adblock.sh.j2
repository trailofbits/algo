#!/usr/bin/env bash
set -euo pipefail

CONFIG_DIR={{ ((config_prefix | default('/')) ~ 'etc/dnscrypt-proxy') | quote }}
WHITELIST="$CONFIG_DIR/white.list"
BLACKLIST="$CONFIG_DIR/black.list"
BLOCKHOSTS="$CONFIG_DIR/blacklist.txt"
WORK_DIR="$(mktemp -d "$CONFIG_DIR/.adblock.XXXXXX")"
trap 'find "$WORK_DIR" -depth -delete' EXIT

BLOCKLIST_URLS=(
{% for url in adblock_lists %}
  {{ url | quote }}
{% endfor %}
)

: >"$WORK_DIR/hosts"
echo 'Downloading hosts lists...'
for url in "${BLOCKLIST_URLS[@]}"; do
  if ! wget --timeout=2 --tries=3 -qO- "$url" >"$WORK_DIR/download"; then
    echo "Failed to download blocklist $url; keeping $BLOCKHOSTS. Retry the refresh." >&2
    exit 1
  fi
  awk '
    !/localhost|#/ {
      sub(/^(0\.0\.0\.0|127\.0\.0\.1|255\.255\.255\.255)[[:space:]]+/, "")
      if (NF) print $1
    }
  ' "$WORK_DIR/download" >>"$WORK_DIR/hosts"
done

if [ -s "$BLACKLIST" ]; then
  awk '/^[^#]/ && NF {print $1}' "$BLACKLIST" >>"$WORK_DIR/hosts"
fi
sort -u "$WORK_DIR/hosts" >"$WORK_DIR/sorted"

if [ -s "$WHITELIST" ]; then
  awk '/^[^#]/ && NF {sub(/\r$/, ""); print $1}' "$WHITELIST" >"$WORK_DIR/whitelist"
  # grep returns 1 when the whitelist removes every entry, which is valid.
  grep -vf "$WORK_DIR/whitelist" "$WORK_DIR/sorted" >"$WORK_DIR/blocklist" || {
    status=$?
    if [ "$status" -ne 1 ]; then
      echo "Failed to filter $WHITELIST; keeping $BLOCKHOSTS. Check the expressions." >&2
      exit "$status"
    fi
  }
else
  cp "$WORK_DIR/sorted" "$WORK_DIR/blocklist"
fi

chmod 0644 "$WORK_DIR/blocklist"
mv "$WORK_DIR/blocklist" "$BLOCKHOSTS"
echo 'Restarting dns service...'
systemctl restart dnscrypt-proxy.service
