# Older releases normalize mapped addresses to IPv4; newer releases preserve the IPv6 form.
{% for mapped in ['', '::ffff:'] %}
{{ mapped }}0.0.0.0
{{ mapped }}10.*
{{ mapped }}127.*
{{ mapped }}169.254.*
{% for subnet in range(16, 32) %}
{{ mapped }}172.{{ subnet }}.*
{% endfor %}
{{ mapped }}192.168.*
{% endfor %}

# The parser trims one trailing colon; this prefix matches only the canonical "::".
:::*
::1
# dnscrypt-proxy 2.0.x requires complete hextet prefixes; CIDR needs a newer release.
{% for prefix in range(0xfc00, 0xfe00) %}
{{ '%x' | format(prefix) }}:*
{% endfor %}
{% for prefix in range(0xfe80, 0xfec0) %}
{{ '%x' | format(prefix) }}:*
{% endfor %}
2001:db8:*
